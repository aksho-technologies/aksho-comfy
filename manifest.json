  },
  "packs": [
    {
      "id": "core",
      "label": "Core",
      "description": "ComfyUI and the Aksho pieces every picture runs on.",
      "required": true,
      "tier": "core",
      "components": [
        "comfyui-portable",
        "ext-aksho-modelinfo",
        "ext-aksho-content-check",
        "model-wd-vit-tagger-v3",
        "model-wd-vit-tagger-v3-tags",
        "aksho-relay-agent"
      ]
    },
    {
      "id": "base-anime",
      "label": "Anime",
      "description": "Clean anime art from an Anima checkpoint.",
      "tier": "base",
      "worksWith": [
        "anima"
      ],
      "components": []
    },
    {
      "id": "base-2-5d",
      "label": "2.5D",
      "description": "Dreamhex: anime characters with depth, soft shading and rich light. An Illustrious checkpoint.",
      "tier": "base",
      "worksWith": [
        "illustrious"
      ],
      "components": [
        "model-checkpoint-dreamhex-v5"
      ]
    },
    {
      "id": "base-realistic",
      "label": "Realistic",
      "description": "Pictures that look like photographs, from a Krea2 checkpoint.",
      "tier": "base",
      "worksWith": [
        "krea2"
      ],
      "components": []
    },
    {
      "id": "base-aio",
      "label": "All in One",
      "description": "MOSS Image: one model for any style, realistic, anime or painterly. For 24 GB cards and Cloud GPU rigs.",
      "tier": "base",
      "worksWith": [
        "moss"
      ],
      "components": [
        "model-moss-image-sft"
      ]
    },
    {
      "id": "base-aio-lite",
      "label": "All in One Lite",
      "description": "The same MOSS Image model made smaller to run on 8 GB cards.",
      "tier": "base",
      "worksWith": [
        "moss-lite"
      ],
      "components": [
        "model-moss-image-sft-int8"
      ]
    },
    {
      "id": "illustrious",
      "label": "Illustrious support",
      "description": "Image Reference, face and hand cleanup and the anime upscaler, for Illustrious checkpoints.",
      "tier": "family",
      "components": [
        "ext-ipadapter-plus",
        "model-clip-vision-vith",
        "model-ipadapter-noob",
        "ext-impact-pack",
        "ext-impact-subpack",
        "model-adetailer-face",
        "model-adetailer-hand",
        "model-upscale-4x-animesharp"
      ]
    },
    {
      "id": "moss",
      "label": "MOSS support",
      "description": "Text encoder and VAE for MOSS Image at full size.",
      "tier": "family",
      "components": [
        "model-text-encoder-qwen35-9b",
        "model-vae-flux2-small"
      ]
    },
    {
      "id": "moss-lite",
