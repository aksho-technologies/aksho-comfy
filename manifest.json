      "description": "Text encoder and VAE for MOSS Image Lite, sized for 8 GB cards.",
      "tier": "family",
      "components": [
        "model-text-encoder-qwen35-9b-w4a8",
        "model-vae-flux2-small"
      ]
    },
    {
      "id": "anima",
