{
  "bundleVersion": "2026.08.06-1",
  "installerVersion": "1.1.0",
  "installerUrl": "https://dl.akshoai.com/installer/install.ps1",
  "minDiskSpaceGB": 15,
  "basePipPackages": [
    "matplotlib"
  ],
  "requirements": {
    "os": "Windows 10/11 64-bit",
    "gpu": "NVIDIA"
  },
  "packs": [
    {
      "id": "core",
      "label": "Core",
      "description": "Everything you need to start generating right now. The rest is optional.",
      "required": true,
      "components": [
        "comfyui-portable",
        "ext-aksho-modelinfo",
        "aksho-relay-agent",
        "model-checkpoint-dreamhex-v5",
        "ext-ipadapter-plus",
        "model-clip-vision-vith",
        "model-ipadapter-noob"
      ]
    },
    {
      "id": "adetailer",
      "label": "ADetailer",
      "description": "Automatic face and hand cleanup after every generation.",
      "components": [
        "ext-impact-pack",
        "ext-impact-subpack",
        "model-adetailer-face",
        "model-adetailer-hand"
      ]
    },
    {
      "id": "upscale",
      "label": "Upscaling",
      "description": "Anime-tuned upscaler for high-resolution output.",
      "components": [
        "model-upscale-4x-animesharp"
      ]
    },
    {
      "id": "poser",
      "label": "3D Poser",
      "description": "Pose a 3D figure and generate from the skeleton or its depth map.",
      "components": [
        "model-controlnet-openpose",
        "model-controlnet-depth"
      ]
    },
    {
      "id": "inpaint",
      "label": "Inpaint",
      "description": "Paint a mask and regenerate, fill or erase inside it.",
      "components": [
        "ext-inpaint-nodes",
        "ext-impact-pack",
        "model-inpaint-lama"
      ]
    },
    {
      "id": "multi",
      "label": "Multi-Character",
      "description": "Place several hosts on a grid and keep each one's identity in its own region.",
      "components": [
        "ext-res4lyf",
        "ext-gligen-xl",
        "model-gligen-xl",
        "model-clip-l",
        "model-clip-g"
      ]
    },
    {
      "id": "anima",
      "label": "Anima support",
      "description": "Text encoder for Anima checkpoints. Bring your own checkpoint.",
      "components": [
        "model-text-encoder-qwen3"
      ]
    },
    {
      "id": "z-image",
      "label": "Z-Image support",
      "description": "Text encoder and VAE for Z-Image checkpoints. Bring your own checkpoint.",
      "components": [
        "model-text-encoder-qwen3-4b",
        "model-vae-z-image"
      ]
    },
    {
      "id": "krea2",
      "label": "Krea2 support",
      "description": "Text encoder and VAE for Krea2 checkpoints. Bring your own checkpoint.",
      "components": [
        "model-text-encoder-qwen3vl-4b",
        "model-vae-qwen-image"
      ]
    }
  ],
