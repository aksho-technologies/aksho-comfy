      "tier": "family",
      "components": [
        "model-text-encoder-qwen3vl-4b",
        "model-vae-qwen-image"
      ]
    },
    {
      "id": "poser",
      "label": "3D Poser",
      "description": "Pose a 3D figure and generate from the skeleton or its depth map.",
      "tier": "recommended",
      "components": [
        "model-controlnet-openpose",
        "model-controlnet-depth"
      ],
      "worksWith": [
        "illustrious"
      ]
    },
    {
      "id": "inpaint",
